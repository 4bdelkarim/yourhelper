# .env.docker.example — configuration Docker (phase 6)
# ============================================================
# docker compose lit automatiquement le `.env` à la racine du projet pour
# interpoler ${VARS} du compose, ET le service api le charge via env_file
# (voir docker-compose.yml). Ce fichier est un MODELE : copier en `.env`
# pour personnaliser (le `.env` n'est jamais commité).

# --- Ollama ---
# Force dans docker-compose.yml à http://host.docker.internal:11434
# (la valeur ci-dessous n'apparaît que pour la lisibilité de ce qui tourne
# réellement en Docker).
OLLAMA_HOST=http://host.docker.internal:11434
# Timeout réseau des appels Ollama en secondes (recommandé pour l'API).
OLLAMA_TIMEOUT=300

# --- Modèles (ceux déjà présents sur l'HOTE, cf. `ollama list`) ---
GEN_MODEL=qwen2.5:14b
JUDGE_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Génération ---
MAX_TOKENS=900
NUM_CTX=24576
KEEP_ALIVE=30m

# --- ChromaDB (bind-mount ./chroma_db:/app/chroma_db dans le compose) ---
# Chemin relatif au CWD du conteneur (/app), identique au fonctionnement local.
DB_DIR=chroma_db
COLLECTION_NAME=cours_ml_fig

# --- Retrieval ---
RETRIEVAL_MODE=hybrid_rerank
RERANKER_REFUSAL_THRESHOLD=0.1119

# --- Logs ---
LOG_LEVEL=WARNING

# GPU CUDA absent en Docker (torch CPU) → évite le warning PyTorch
CUDA_VISIBLE_DEVICES=
