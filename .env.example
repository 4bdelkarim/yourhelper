# Configuration rag_tutor — LU au démarrage par src/rag_tutor/settings.py.
# Copier en `.env` pour personnaliser (jamais committé). SANS ce fichier,
# le comportement = valeurs par défaut ci-dessous = comportement historique.

# --- Ollama ---
# Instance Ollama principale. En Docker (phase 6) : http://host.docker.internal:11434
OLLAMA_HOST=http://127.0.0.1:11434
# Timeout réseau des appels Ollama en secondes. Vide = AUCUN timeout
# (comportement historique). Recommandé pour l'API : 300
OLLAMA_TIMEOUT=

# --- Modèles (cf. `ollama list`) ---
GEN_MODEL=qwen2.5:14b
JUDGE_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Génération ---
# MAX_TOKENS : 400 (contrainte historique CPU) coupait les réponses.
# NUM_CTX : 24576 économise ~25% de KV cache ; remonter à 32768 si contexte coupé.
MAX_TOKENS=900
NUM_CTX=24576
KEEP_ALIVE=30m

# --- ChromaDB (client embarqué, chemin relatif au CWD) ---
# En Docker : volume bind-mount, cf. docker-compose (phase 6).
DB_DIR=chroma_db
COLLECTION_NAME=cours_ml_fig

# --- Retrieval ---
# "dense" | "hybrid" | "hybrid_rerank" (comportement évalué : hybrid_rerank)
RETRIEVAL_MODE=hybrid_rerank
# Seuil de refus M1 sur le score du cross-encoder — NE PAS modifier sans
# re-calibrer via evaluation/calibrate.py (cf. eval/reranker_calibration.json).
RERANKER_REFUSAL_THRESHOLD=0.1119

# --- Logs rag_tutor (chemin requête : dégradation reranker, retries...) ---
# DEBUG | INFO | WARNING (défaut) | ERROR
LOG_LEVEL=WARNING

# --- Hors-ligne OPTIONNEL (reranker) ---
# Le Makefile l'active AUTOMATIQUEMENT dès que le modèle bge-reranker est dans
# le cache HF (~600 Mo, après `make setup`). Inutile de le définir à la main.
# HF_HUB_OFFLINE=1

# GPU CUDA absent sur certaines machines → évite le warning PyTorch
CUDA_VISIBLE_DEVICES=
